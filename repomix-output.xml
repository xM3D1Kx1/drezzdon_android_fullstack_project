}

// Загрузка изображения
document.getElementById('imageLoader').addEventListener('change', (e) => {
  const file = e.target.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = (event) => {
    const img = new Image();
    img.onload = () => {
      const maxDim = 1000;
      let w = img.width, h = img.height;
      if (w > maxDim || h > maxDim) {
        if (w > h) { h = Math.round((h * maxDim) / w); w = maxDim; }
        else { w = Math.round((w * maxDim) / h); h = maxDim; }
      }
      canvas.width = w;
      canvas.height = h;
      baseImage = img;
      autoGenerateDrezzdon();
    };
    img.src = event.target.result;
  };
  reader.readAsDataURL(file);
});

// Анализ изображения: поиск темного/контрастного объекта, граней перспективы и фоновых деталей
function analyzeImageRegions() {
  const w = canvas.width, h = canvas.height;
  if (!baseImage) {
    return {
      subjectHead: { x: w * 0.43, y: h * 0.30, w: w * 0.09, h: h * 0.09 },
      subjectHandL: { x: w * 0.40, y: h * 0.48, w: w * 0.035, h: h * 0.04 },
      subjectHandR: { x: w * 0.54, y: h * 0.51, w: w * 0.04, h: h * 0.045 },
      ledgeStart: { x: w * 0.60, y: h * 0.60 },
      ledgeEnd: { x: w * 0.25, y: h * 0.99 },
      buildingCluster: { x: w * 0.50, y: h * 0.16 },
      blurZone: { x: w * 0.86, y: h * 0.19 }
    };
  }

  // Сжимаем на временный холст 100x100 для быстрого поиска контраста и силуэта
  const sw = 100, sh = 100;
  const off = document.createElement('canvas');
  off.width = sw; off.height = sh;
  const octx = off.getContext('2d');
  octx.drawImage(baseImage, 0, 0, sw, sh);
  const data = octx.getImageData(0, 0, sw, sh).data;

  // Ищем центр масс самого контрастного/темного объекта в центральной зоне (силуэт/персонаж/объект)
  let bestScore = -1, bestX = 48, bestY = 42;
  for (let y = 25; y < 75; y++) {
    for (let x = 20; x < 80; x++) {
      const idx = (y * sw + x) * 4;
      const lum = 0.299 * data[idx] + 0.587 * data[idx+1] + 0.114 * data[idx+2];
      const idxRight = (y * sw + Math.min(99, x + 2)) * 4;
      const lumRight = 0.299 * data[idxRight] + 0.587 * data[idxRight+1] + 0.114 * data[idxRight+2];
      const grad = Math.abs(lum - lumRight);
      // Приоритет темным силуэтам и контрастным границам ближе к центру
      const centerWeight = 1 - Math.hypot(x - 50, y - 48) / 60;
      const score = ((255 - lum) * 0.6 + grad * 1.8) * Math.max(0.2, centerWeight);
      if (score > bestScore) {
        bestScore = score;
        bestX = x;
        bestY = y;
      }
    }
  }

  const sx = (bestX / sw) * w;
  const sy = (bestY / sh) * h;

  return {
    subjectHead: {
      x: Math.max(w * 0.15, Math.min(w * 0.75, sx - w * 0.045)),
      y: Math.max(h * 0.18, Math.min(h * 0.60, sy - h * 0.10)),
      w: w * 0.085,
      h: w * 0.085
    },
    subjectHandL: {
      x: Math.max(w * 0.1, sx - w * 0.07),
      y: Math.min(h * 0.80, sy + h * 0.06),
      w: w * 0.035,
      h: w * 0.035
    },
    subjectHandR: {
      x: Math.min(w * 0.85, sx + w * 0.06),
      y: Math.min(h * 0.82, sy + h * 0.09),
      w: w * 0.04,
      h: w * 0.04
    },
    ledgeStart: { x: Math.min(w * 0.85, sx + w * 0.12), y: Math.min(h * 0.75, sy + h * 0.18) },
    ledgeEnd: { x: Math.max(w * 0.15, sx - w * 0.22), y: h * 0.98 },
    buildingCluster: { x: w * 0.52, y: h * 0.16 },
    blurZone: { x: w * 0.85, y: h * 0.18 }
  };
}

// Авто-генерация в точном стиле референса drezzdon
function autoGenerateDrezzdon() {
  const w = canvas.width, h = canvas.height;
  const reg = analyzeImageRegions();
  elements = [];

  // 1. Связка главного объекта: Рамка головы (с легким затемнением/размытием) + 2 рамки деталей + ломаные стрелки 90°
  elements.push({
    type: 'orthoChain',
    head: { x: reg.subjectHead.x, y: reg.subjectHead.y, w: reg.subjectHead.w, h: reg.subjectHead.h, censor: 'darkblur' },
    handL: { x: reg.subjectHandL.x, y: reg.subjectHandL.y, w: reg.subjectHandL.w, h: reg.subjectHandL.h },
    handR: { x: reg.subjectHandR.x, y: reg.subjectHandR.y, w: reg.subjectHandR.w, h: reg.subjectHandR.h, censor: 'blur' },
    mainLabel: pickRandom(TEXT_POOLS.subject),
    subLabel: pickRandom(TEXT_POOLS.connector)
  });

  // 2. Текст в небе со стрелкой (верхний левый угол, как "reminder: water!!")
  elements.push({
    type: 'pointerText',
    x: w * 0.13,
    y: h * 0.05,
    ax: w * 0.34,
    ay: h * 0.035,
    text: pickRandom(TEXT_POOLS.sky),
    align: 'left'
  });

  // 3. Текст справа со стрелкой на размытую зону ("what do we have to lose??")
  elements.push({
    type: 'pointerText',
    x: w * 0.82,
    y: h * 0.075,
    ax: reg.blurZone.x,
    ay: reg.blurZone.y,
    text: pickRandom(TEXT_POOLS.distant),
    align: 'center',
    blurTarget: true
  });

  // 4. Кластер связанных пунктиром окон/деталей на заднем плане
  elements.push({
    type: 'windowCluster',
    pts: [
      { x: reg.buildingCluster.x - w * 0.045, y: reg.buildingCluster.y - h * 0.01, s: w * 0.032 },
      { x: reg.buildingCluster.x, y: reg.buildingCluster.y + h * 0.03, s: w * 0.032 },
      { x: reg.buildingCluster.x + w * 0.055, y: reg.buildingCluster.y - h * 0.012, s: w * 0.032 }
    ]
  });

  // 5. Пунктирные линии перспективы (вдоль граней/бордюра)
  elements.push({
    type: 'dashedPath',
    pts: [
      { x: reg.ledgeStart.x, y: reg.ledgeStart.y },
      { x: reg.ledgeEnd.x, y: reg.ledgeEnd.y }
    ]
  });
  elements.push({
    type: 'dashedPath',
    pts: [
      { x: reg.ledgeStart.x + w * 0.035, y: reg.ledgeStart.y + h * 0.01 },
      { x: reg.ledgeStart.x + w * 0.035, y: reg.ledgeStart.y + h * 0.11 },
      { x: reg.ledgeStart.x - w * 0.045, y: h * 0.99 }
    ]
  });

  // 6. Пунктирные 3D-ромбы на поверхности земли + пунктирный эллипс
  elements.push({
    type: 'rhombusGroup',
    x: w * 0.14,
    y: h * 0.80,
    scale: w * 0.032
  });
  elements.push({
    type: 'dottedOval',
    x: reg.subjectHead.x + w * 0.17,
    y: reg.subjectHead.y + h * 0.15,
    rx: w * 0.028,
    ry: h * 0.011
  });

  // 7. Полупрозрачный красный геометрический полигон с обводкой внизу справа
  elements.push({
    type: 'redPolygon',
    x: reg.ledgeStart.x + w * 0.02,
    y: h * 0.77,
    scale: w * 0.16
  });

  render();
}

// Вспомогательные функции рисования
function applyRedStyle(lineWidth = 3, glow = 10) {
  ctx.strokeStyle = '#ff1e1e';
  ctx.fillStyle = '#ff1e1e';
  ctx.lineWidth = lineWidth;
  ctx.shadowColor = 'rgba(255, 20, 20, 0.85)';
  ctx.shadowBlur = glow;
  ctx.lineCap = 'round';
  ctx.lineJoin = 'round';
}

function drawArrowHead(x1, y1, x2, y2, size = 11) {
  const angle = Math.atan2(y2 - y1, x2 - x1);
  ctx.save();
  ctx.setLineDash([]);
  ctx.beginPath();
  ctx.moveTo(x2, y2);
  ctx.lineTo(x2 - size * Math.cos(angle - Math.PI / 6), y2 - size * Math.sin(angle - Math.PI / 6));
  ctx.lineTo(x2 - size * Math.cos(angle + Math.PI / 6), y2 - size * Math.sin(angle + Math.PI / 6));
  ctx.closePath();
  ctx.fill();
  ctx.restore();
}

function drawCensorBox(x, y, w, h, mode) {
  ctx.save();
  if (mode === 'darkblur') {
    ctx.filter = 'blur(8px) brightness(0.25) contrast(1.6)';
    if (baseImage) {
      ctx.beginPath();
      ctx.rect(x, y, w, h);
      ctx.clip();
      ctx.drawImage(baseImage, 0, 0, canvas.width, canvas.height);
    } else {
      ctx.fillStyle = '#050505';
      ctx.fillRect(x, y, w, h);
    }
  } else if (mode === 'blur') {
    ctx.filter = 'blur(10px)';
    if (baseImage) {
      ctx.beginPath();
      ctx.rect(x, y, w, h);
      ctx.clip();
      ctx.drawImage(baseImage, 0, 0, canvas.width, canvas.height);
    }
  }
  ctx.restore();
}

function render() {
  const w = canvas.width, h = canvas.height;
  ctx.clearRect(0, 0, w, h);

  // Фон или фото с легкой цветокоррекцией под холодный weirdcore/drezzdon
  if (baseImage) {
    const preset = document.getElementById('stylePreset').value;
    ctx.save();
    if (preset === 'drezzdon') ctx.filter = 'contrast(1.06) saturate(0.88) brightness(0.95)';
    else if (preset === 'weirdcore') ctx.filter = 'contrast(1.20) saturate(0.75) brightness(0.90)';
    else if (preset === 'dreamcore') ctx.filter = 'contrast(0.95) saturate(1.15) brightness(1.02)';
    ctx.drawImage(baseImage, 0, 0, w, h);
    ctx.restore();
  } else {
    ctx.fillStyle = '#1d242b';
    ctx.fillRect(0, 0, w, h);
  }

  const baseFont = Math.max(16, Math.round(w * 0.032));

  elements.forEach((el) => {
    ctx.save();
    applyRedStyle(Math.max(2.5, w * 0.0038), 10);

    if (el.type === 'orthoChain') {
      const { head, handL, handR } = el;
      if (head.censor) drawCensorBox(head.x, head.y, head.w, head.h, head.censor);
      if (handR.censor) drawCensorBox(handR.x, handR.y, handR.w, handR.h, handR.censor);

      // 3 красные рамки
      ctx.strokeRect(head.x, head.y, head.w, head.h);
      ctx.strokeRect(handL.x, handL.y, handL.w, handL.h);
      ctx.strokeRect(handR.x, handR.y, handR.w, handR.h);

      // Ломаная стрелка 90°: от правой стороны головы -> вправо -> строго вниз к правой руке
      const elbow1X = handR.x + handR.w * 0.5;
      const start1Y = head.y + head.h * 0.45;
      const end1Y = handR.y - 6;
      ctx.beginPath();
      ctx.moveTo(head.x + head.w + 8, start1Y);
      ctx.lineTo(elbow1X, start1Y);
      ctx.lineTo(elbow1X, end1Y);
      ctx.stroke();
      drawArrowHead(elbow1X, start1Y, elbow1X, end1Y, 12);

      // Ломаная стрелка 90°: снизу левой руки -> вниз -> вправо к правой руке
      const start2X = handL.x + handL.w * 0.5;
      const elbow2Y = handR.y + handR.h * 0.5;
      const end2X = handR.x - 6;
      ctx.beginPath();
      ctx.moveTo(start2X, handL.y + handL.h + 4);
      ctx.lineTo(start2X, elbow2Y);
      ctx.lineTo(end2X, elbow2Y);
      ctx.stroke();
      drawArrowHead(start2X, elbow2Y, end2X, elbow2Y, 11);

      // Подпись над нижней стрелкой ("interest")
      ctx.font = `600 ${Math.round(baseFont * 0.55)}px Inter, Arial, sans-serif`;
      ctx.textAlign = 'center';
      ctx.fillText(el.subLabel, (start2X + end2X) / 2, elbow2Y - 7);

      // Главная надпись слева от силуэта ("still moving forward <3")
      ctx.font = `700 ${baseFont}px Inter, Arial, sans-serif`;
      ctx.textAlign = 'right';
      ctx.fillText(el.mainLabel, head.x - 16, head.y + head.h + baseFont * 1.45);
      ctx.textAlign = 'left';
      ctx.fillText('<3', head.x + head.w * 0.25, head.y + head.h + baseFont * 1.40);
    }

    else if (el.type === 'pointerText') {
      if (el.blurTarget) {
        drawCensorBox(el.ax - w * 0.06, el.ay - h * 0.02, w * 0.12, h * 0.055, 'blur');
      }
      ctx.font = `700 ${Math.round(baseFont * 0.92)}px Inter, Arial, sans-serif`;
      ctx.textAlign = el.align || 'left';
      const lines = el.text.split('\n');
      lines.forEach((line, idx) => {
        ctx.fillText(line, el.x, el.y + idx * (baseFont * 0.98));
      });

      // Стрелка от текста к точке (ax, ay)
      const startX = el.align === 'center' ? el.x + 12 : el.x + w * 0.16;
      const startY = el.y + (lines.length - 1) * baseFont * 0.75;
      ctx.beginPath();
      ctx.moveTo(startX, startY);
      ctx.lineTo(el.ax, el.ay);
      ctx.stroke();
      drawArrowHead(startX, startY, el.ax, el.ay, 12);
    }

    else if (el.type === 'windowCluster') {
      const pts = el.pts;
      ctx.lineWidth = Math.max(2, w * 0.003);
      pts.forEach(p => {
        ctx.setLineDash([]);
        ctx.strokeRect(p.x - p.s / 2, p.y - p.s / 2, p.s, p.s);
      });
      ctx.setLineDash([6, 6]);
      ctx.beginPath();
      for (let i = 0; i < pts.length - 1; i++) {
        ctx.moveTo(pts[i].x, pts[i].y);
        ctx.lineTo(pts[i + 1].x, pts[i + 1].y);
      }
      ctx.stroke();
    }

    else if (el.type === 'dashedPath') {
      ctx.setLineDash([12, 10]);
      ctx.beginPath();
      el.pts.forEach((p, idx) => {
        if (idx === 0) ctx.moveTo(p.x, p.y);
        else ctx.lineTo(p.x, p.y);
      });
      ctx.stroke();
    }

    else if (el.type === 'rhombusGroup') {
      const s = el.scale;
      const offsets = [
        { dx: 0, dy: 0 },
        { dx: s * 1.9, dy: s * 0.7 },
        { dx: -s * 2.7, dy: s * 1.7 }
      ];
      ctx.setLineDash([5, 5]);
      offsets.forEach(o => {
        const cx = el.x + o.dx, cy = el.y + o.dy;
        ctx.beginPath();
        ctx.moveTo(cx, cy - s * 0.55);
        ctx.lineTo(cx + s, cy);
        ctx.lineTo(cx, cy + s * 0.55);
        ctx.lineTo(cx - s, cy);
        ctx.closePath();
        ctx.stroke();
      });
    }

    else if (el.type === 'dottedOval') {
      ctx.setLineDash([4, 5]);
      ctx.beginPath();
      ctx.ellipse(el.x, el.y, el.rx, el.ry, 0, 0, Math.PI * 2);
      ctx.stroke();
    }

    else if (el.type === 'redPolygon') {
      const s = el.scale;
      const x = el.x, y = el.y;
      ctx.setLineDash([]);
      ctx.fillStyle = 'rgba(255, 25, 25, 0.52)';
      ctx.beginPath();
      ctx.moveTo(x, y);
      ctx.lineTo(x + s * 0.22, y + s * 0.03);
      ctx.lineTo(x + s * 0.16, y + s * 0.35);
      ctx.lineTo(x + s * 1.15, y + s * 0.32);
      ctx.lineTo(x + s * 1.10, y + s * 0.50);
      ctx.lineTo(x + s * 0.72, y + s * 0.50);
      ctx.lineTo(x + s * 0.72, y + s * 0.85);
      ctx.lineTo(x + s * 0.42, y + s * 0.85);
      ctx.lineTo(x + s * 0.38, y + s * 0.55);
      ctx.lineTo(x + s * 0.25, y + s * 1.02);
      ctx.lineTo(x - s * 0.08, y + s * 1.0);
      ctx.closePath();
      ctx.fill();
      ctx.stroke();
    }

    ctx.restore();
  });
}

// Инструменты ручного добавления элементов
function addOrthogonalPair() {
  const w = canvas.width, h = canvas.height;
  elements.push({
    type: 'orthoChain',
    head: { x: w * 0.4, y: h * 0.3, w: w * 0.09, h: w * 0.09, censor: 'darkblur' },
    handL: { x: w * 0.36, y: h * 0.48, w: w * 0.04, h: w * 0.04 },
    handR: { x: w * 0.52, y: h * 0.50, w: w * 0.04, h: w * 0.04, censor: 'blur' },
    mainLabel: pickRandom(TEXT_POOLS.subject),
    subLabel: pickRandom(TEXT_POOLS.connector)
  });
  render();
}

function addWindowCluster() {
  const w = canvas.width, h = canvas.height;
  elements.push({
    type: 'windowCluster',
    pts: [
      { x: w * 0.45, y: h * 0.2, s: w * 0.035 },
      { x: w * 0.50, y: h * 0.24, s: w * 0.035 },
      { x: w * 0.55, y: h * 0.2, s: w * 0.035 }
    ]
  });
  render();
}

function addPerspectiveLine() {
  const w = canvas.width, h = canvas.height;
  elements.push({
    type: 'dashedPath',
    pts: [{ x: w * 0.6, y: h * 0.6 }, { x: w * 0.25, y: h * 0.95 }]
  });
  render();
}

function addRhombusCluster() {
  elements.push({ type: 'rhombusGroup', x: canvas.width * 0.2, y: canvas.height * 0.8, scale: canvas.width * 0.032 });
  render();
}

function addRedPolygon() {
  elements.push({ type: 'redPolygon', x: canvas.width * 0.6, y: canvas.height * 0.75, scale: canvas.width * 0.15 });
  render();
}

function addPointerText() {
  const txt = prompt('Введите текст (используйте перенос или оставьте по умолчанию):', 'reminder: water!!');
  if (!txt) return;
  elements.push({
    type: 'pointerText',
    x: canvas.width * 0.2,
    y: canvas.height * 0.15,
    ax: canvas.width * 0.38,
    ay: canvas.height * 0.12,
    text: txt.replace(/\\n/g, '\n'),
    align: 'left'
  });
  render();
}

function deleteSelected() {
  if (selectedEl) {
    elements = elements.filter(e => e !== selectedEl);
    selectedEl = null;
    render();
  }
}

// Интерактивное перетаскивание узлов и редактирование текста по двойному клику
function getCanvasCoords(e) {
  const rect = canvas.getBoundingClientRect();
  const clientX = e.touches ? e.touches[0].clientX : e.clientX;
  const clientY = e.touches ? e.touches[0].clientY : e.clientY;
  return {
    x: (clientX - rect.left) * (canvas.width / rect.width),
    y: (clientY - rect.top) * (canvas.height / rect.height)
  };
}

function hitTest(pos) {
  for (let i = elements.length - 1; i >= 0; i--) {
    const el = elements[i];
    if (el.type === 'orthoChain') {
      for (const key of ['head', 'handL', 'handR']) {
        const b = el[key];
        if (pos.x >= b.x && pos.x <= b.x + b.w && pos.y >= b.y && pos.y <= b.y + b.h) {
          return { el, handle: b, offset: { x: pos.x - b.x, y: pos.y - b.y } };
        }
      }
    } else if (el.type === 'pointerText') {
      if (Math.hypot(pos.x - el.ax, pos.y - el.ay) < 28) {
        return { el, handle: 'arrow', offset: { x: pos.x - el.ax, y: pos.y - el.ay } };
      }
      if (Math.hypot(pos.x - el.x, pos.y - el.y) < 90) {
        return { el, handle: 'pos', offset: { x: pos.x - el.x, y: pos.y - el.y } };
      }
    } else if (el.type === 'windowCluster' || el.type === 'dashedPath') {
      for (const p of el.pts) {
        if (Math.hypot(pos.x - p.x, pos.y - p.y) < 30) {
          return { el, handle: p, offset: { x: pos.x - p.x, y: pos.y - p.y } };
        }
      }
    } else if (el.x !== undefined && el.y !== undefined) {
      if (Math.hypot(pos.x - el.x, pos.y - el.y) < 75) {
        return { el, handle: el, offset: { x: pos.x - el.x, y: pos.y - el.y } };
      }
    }
  }
  return null;
}

function onPointerDown(e) {
  const pos = getCanvasCoords(e);
  const hit = hitTest(pos);
  const now = Date.now();

  if (hit) {
    selectedEl = hit.el;
    selectedHandle = hit.handle;
    dragOffset = hit.offset;

    // Двойной клик / тап редактирует текст
    if (now - lastTap < 320) {
      if (selectedEl.type === 'pointerText') {
        const next = prompt('Изменить надпись:', selectedEl.text);
        if (next !== null) selectedEl.text = next;
      } else if (selectedEl.type === 'orthoChain') {
        const nextMain = prompt('Изменить главную надпись:', selectedEl.mainLabel);
        if (nextMain !== null) selectedEl.mainLabel = nextMain;
        const nextSub = prompt('Изменить подпись стрелки:', selectedEl.subLabel);
        if (nextSub !== null) selectedEl.subLabel = nextSub;
      }
      selectedHandle = null;
      render();
    }
  }
  lastTap = now;
}

function onPointerMove(e) {
  if (!selectedHandle || !selectedEl) return;
  e.preventDefault();
  const pos = getCanvasCoords(e);
  if (selectedHandle === 'arrow') {
    selectedEl.ax = pos.x - dragOffset.x;
    selectedEl.ay = pos.y - dragOffset.y;
  } else if (selectedHandle === 'pos') {
    selectedEl.x = pos.x - dragOffset.x;
    selectedEl.y = pos.y - dragOffset.y;
  } else {
    selectedHandle.x = pos.x - dragOffset.x;
    selectedHandle.y = pos.y - dragOffset.y;
  }
  render();
}

function onPointerUp() {
  selectedHandle = null;
}

canvas.addEventListener('mousedown', onPointerDown);
window.addEventListener('mousemove', onPointerMove);
window.addEventListener('mouseup', onPointerUp);
canvas.addEventListener('touchstart', onPointerDown, { passive: false });
window.addEventListener('touchmove', onPointerMove, { passive: false });
window.addEventListener('touchend', onPointerUp);
document.getElementById('stylePreset').addEventListener('change', render);

function exportImage() {
  const link = document.createElement('a');
  link.download = `drezzdon_edit_${Date.now()}.png`;
  link.href = canvas.toDataURL('image/png');
  link.click();
}

// Первичный запуск демо-сцены
autoGenerateDrezzdon();
</script>
</body>
</html>
